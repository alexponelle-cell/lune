<section class="section">
  <div class="container">
    <div class="newsletter-box">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 style="margin-top:12px">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
      {%- form 'customer', id: 'newsletter-form', class: 'news-form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label class="visually-hidden" for="newsletter-email">Adresse e-mail</label>
        <input id="newsletter-email" type="email" name="contact[email]" required placeholder="Votre adresse e-mail" autocomplete="email" class="field" style="flex:1 1 220px">
        <button class="btn btn-primary" type="submit">{{ section.settings.button_label }}</button>
        <div class="news-msg" role="status" style="flex-basis:100%">
          {%- if form.posted_successfully? -%}Merci ! Vous êtes inscrit(e).{%- endif -%}
          {%- if form.errors -%}<span class="form-error">{{ form.errors | default_errors }}</span>{%- endif -%}
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Surtitre", "default": "Newsletter" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "-10 % sur votre première commande" },
    { "type": "text", "id": "text", "label": "Texte", "default": "Nouveautés, ventes privées et avant-premières. Un e-mail par semaine, maximum." },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Je profite du -10 %" },
    { "type": "paragraph", "content": "Envoyez le code -10 % avec Shopify Email (Marketing → Automatisations → Bienvenue)." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
