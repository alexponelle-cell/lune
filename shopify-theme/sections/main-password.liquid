<div class="container" style="text-align:center;padding:100px 16px;max-width:560px">
  <span class="eyebrow">Bientôt</span>
  <h1 style="font-size:clamp(34px,5vw,56px);font-weight:900;letter-spacing:-.03em;margin:14px 0">{{ shop.name }} ouvre très vite</h1>
  {%- if shop.password_message != blank -%}<p style="color:var(--text-soft);margin-bottom:28px">{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer', class: 'news-form' -%}
    <input type="hidden" name="contact[tags]" value="prospect,password page">
    <label class="visually-hidden" for="pw-email">E-mail</label>
    <input class="field" id="pw-email" type="email" name="contact[email]" required placeholder="Votre e-mail pour être prévenu(e)" style="flex:1 1 220px">
    <button class="btn btn-primary" type="submit">Me prévenir</button>
    {%- if form.posted_successfully? -%}<p class="news-msg" style="flex-basis:100%">Merci, vous serez prévenu(e) à l'ouverture !</p>{%- endif -%}
  {%- endform -%}
  <details style="margin-top:40px;color:var(--muted)">
    <summary style="cursor:pointer">Accès propriétaire</summary>
    {%- form 'storefront_password', class: 'news-form', style: 'margin-top:14px' -%}
      <label class="visually-hidden" for="pw">Mot de passe</label>
      <input class="field" id="pw" type="password" name="password" placeholder="Mot de passe" style="flex:1 1 200px">
      <button class="btn btn-ghost" type="submit">Entrer</button>
      {%- if form.errors -%}<p class="form-error" style="flex-basis:100%">Mot de passe incorrect.</p>{%- endif -%}
    {%- endform -%}
  </details>
</div>

{% schema %}
{ "name": "Page mot de passe" }
{% endschema %}
