# --- Discord ---------------------------------------------------------------
# Token du bot (Developer Portal > Bot). Laisser vide pour lancer seulement le site.
DISCORD_TOKEN=
# Application ID (Developer Portal > General Information)
DISCORD_CLIENT_ID=
# Serveur où enregistrer les slash commands (instantané). Vide = commandes globales.
DISCORD_GUILD_ID=

# --- Stockage ---------------------------------------------------------------
DATABASE_PATH=./data/tracker.db

# --- Site web ---------------------------------------------------------------
WEB_PORT=3000
# Si défini, le dashboard demande ce mot de passe (utilisateur au choix).
DASHBOARD_PASSWORD=

# --- Récupération des vues ---------------------------------------------------
# mock = fausses données qui évoluent dans le temps (dev / démo)
# live = vraies APIs (YouTube Data API + Apify pour TikTok / Instagram)
FETCHER_MODE=mock
YOUTUBE_API_KEY=
APIFY_TOKEN=
# Nombre de vidéos récentes récupérées par compte à chaque passage
VIDEOS_PER_ACCOUNT=30

# --- Planning ---------------------------------------------------------------
COLLECT_INTERVAL_MINUTES=60
RELANCE_CHECK_INTERVAL_MINUTES=180

# --- Règles de relance ------------------------------------------------------
# Relance si aucune vidéo postée depuis N jours
INACTIVITY_DAYS=3
# Relance si les vues des N derniers jours baissent de X % vs les N jours d'avant
DROP_WINDOW_DAYS=7
DROP_THRESHOLD_PERCENT=30
# En dessous de ce volume sur la période précédente, on ignore les baisses (bruit)
DROP_MIN_PREVIOUS_VIEWS=1000
# Délai minimum entre deux relances du même type pour un clipper
RELANCE_COOLDOWN_HOURS=24
